VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# chỉ cho script quản trị, không bao giờ để tiền tố VITE_
SUPABASE_SECRET_KEY=sb_secret_...

# TTS (AI đọc hồ sơ bằng giọng tiếng Việt)
# Mặc định sử dụng Supertonic 3 (https://huggingface.co/supertone-oss-archive/supertonic-3)
# Chạy local server: npm run tts-server (mở tại http://localhost:8000)
VITE_TTS_API_URL=http://localhost:8000/v1/audio/speech
# Giọng đọc Supertonic: F1..F5 (nữ), M1..M5 (nam). Mặc định: F1
# VITE_TTS_VOICE=F1
# VITE_TTS_LANG=vi
