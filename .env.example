VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# chỉ cho script quản trị, không bao giờ để tiền tố VITE_
SUPABASE_SECRET_KEY=sb_secret_...

# Đọc hồ sơ bằng giọng AI (Supertonic 3)
# Mặc định chạy NGAY TRÊN THIẾT BỊ người chơi (ONNX Runtime Web): không cần server.
# Mô hình ~400 MB tải từ Hugging Face sau khi người chơi đồng ý, rồi lưu trong trình duyệt.
# Giọng: F1..F5 (nữ), M1..M5 (nam). Mặc định M1 khi không đặt.
# VITE_TTS_VOICE=M1
# VITE_TTS_LANG=vi
# VITE_TTS_STEPS=8        # ít bước hơn = nhanh hơn, kém mượt hơn
# Tuỳ chọn: dùng server thay vì chạy trên thiết bị (vd. npm run tts-server → http://localhost:8000)
# VITE_TTS_API_URL=http://localhost:8000/v1/audio/speech
# Bản tối ưu (tools/optimize-supertonic.py): thư mục chứa fp16/ (WebGPU, ~200 MB) và int8/ (CPU, ~186 MB).
# Bỏ trống thì mọi máy tải bản fp32 gốc (~400 MB).
# VITE_TTS_MODEL_OPT_BASE=https://huggingface.co/<tài-khoản>/supertonic-3-web/resolve/main/
# Tuỳ chọn: tải mô hình từ chỗ khác thay vì Hugging Face (thư mục có onnx/ và voice_styles/)
# VITE_TTS_MODEL_BASE=https://.../supertonic-3/

# Thẩm vấn nghi phạm bằng AI (Edge Function `interrogate`). Các khoá này đặt trong Supabase Dashboard
# → Edge Functions → Secrets (KHÔNG để tiền tố VITE_, KHÔNG đưa lên web). Bản trong .env.local chỉ để chạy thử trên máy.
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
# AI_DAILY_TURNS=120            # lượt hỏi mỗi người, mỗi hồ sơ, mỗi ngày (đặt ở Secrets của Supabase)
# VITE_AI_INTERROGATION=off     # tắt nút Thẩm vấn trên web
